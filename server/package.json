{
  "name": "nostr-mail-server",
  "version": "0.1.0",
  "description": "Connect your own domain to Nostr Mail.",
  "keywords": [
    "nostr",
    "email",
    "custom-domain",
    "dkim"
  ],
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "check": "biome check",
    "check:write": "biome check --write",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "mailauth": "8.0.1",
    "nostr-tools": "^2.25.2",
    "pg": "^8.23.1",
    "smtp-server": "3.19.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "3.5.13",
    "nodemailer": "10.0.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
