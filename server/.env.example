# HTTP port the API listens on. Default: 3000.
PORT=3000

# SMTP port that receives mail for the connected domains. Default: 2525.
SMTP_PORT=2525

# Postgres connection string. Required.
DATABASE_URL=postgres://nostrmail:nostrmail@localhost:5432/nostrmail

# Host name of the inbound SMTP server that connected domains point their MX
# record at. Required.
MX_HOST=mx.example.com

# Domain whose SPF record lists the outbound SMTP servers. Connected domains are
# asked to add include:<SPF_INCLUDE> to their own SPF record. Required.
SPF_INCLUDE=_spf.example.com

# DKIM selector given to newly connected domains. Changing it does not affect
# domains already connected. Default: nostrmail.
DKIM_SELECTOR=nostrmail

# DNS servers (comma-separated IP addresses) used to check the records of
# connected domains. Default: the system resolver.
DNS_SERVERS=

# Relays (comma-separated wss:// URLs) where the relay lists of recipients are
# looked up. Default: wss://purplepag.es, wss://user.kindpag.es and
# wss://indexer.coracle.social.
INDEXER_RELAYS=
