# HTTP port the API listens on. Default: 3000.
PORT=3000

# SMTP port that receives mail for the connected domains. Default: 2525.
SMTP_PORT=2525

# Largest message accepted over SMTP, and largest blob read to send one, in
# bytes. Default: 26214400 (25 MiB).
MAX_MESSAGE_BYTES=26214400

# Postgres connection string. Required.
DATABASE_URL=postgres://nostrmail:nostrmail@localhost:5432/nostrmail

# Host name of the SMTP server that connected domains point their MX record at.
# The server also greets with it when it sends, so its address should resolve
# back to it (PTR). Required.
MX_HOST=mx.example.com

# Domain whose SPF record lists the address the server sends from. Connected
# domains are asked to add include:<SPF_INCLUDE> to their own SPF record.
# Required.
SPF_INCLUDE=_spf.example.com

# IPv4 address that connected domains point their A record at, where their
# HTTPS reaches /.well-known/nostr.json on this server. Required.
PUBLIC_IPV4=203.0.113.10

# Npubs or hex public keys (comma-separated) allowed to call the /admin routes,
# which show every domain connected to the server. They also receive the mail
# sent to abuse@ on every domain. Default: nobody.
ADMIN_PUBKEYS=

# DKIM selector given to newly connected domains. Changing it does not affect
# domains already connected. Default: nostrmail.
DKIM_SELECTOR=nostrmail

# DNS servers (comma-separated IP addresses) used to check the records of
# connected domains and of the server itself. Default: the system resolver.
DNS_SERVERS=

# Relays (comma-separated wss:// URLs) where the relay lists of recipients are
# looked up. Default: wss://purplepag.es, wss://user.kindpag.es and
# wss://indexer.coracle.social.
INDEXER_RELAYS=

# Blossom servers (comma-separated https:// URLs) given to new claims to store
# messages too large to fit in a gift wrap. Existing claims keep theirs.
# Default: https://blossom.nmail.li, https://blossom.yakihonne.com and
# https://blossom.ditto.pub.
BLOSSOM_SERVERS=

# Relays (comma-separated wss:// URLs) the domain keys announce in their kinds
# 10002 and 10050, publish their lists on, and receive the mail to send on.
# Default: wss://relay.nmail.li, wss://relay.ditto.pub, wss://nos.lol and
# wss://relay.primal.net.
DOMAIN_RELAYS=

# PEM certificate and private key for MX_HOST, offered with STARTTLS. Both or
# neither. They are read again every hour, so renewals apply without a restart.
# Default: STARTTLS is not offered.
TLS_CERT_FILE=
TLS_KEY_FILE=
