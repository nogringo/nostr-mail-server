{
	# A single issuer keeps the certificate where the SMTP server reads it.
	cert_issuer acme

	on_demand_tls {
		ask http://server:3000/certificates/allowed
	}
}

{$SITE_HOST} {
	encode

	@api path /domains /domains/* /admin/* /.well-known/nostr.json /healthz
	handle @api {
		reverse_proxy server:3000
	}

	# The pages are built as admin.html: /admin is the page, /admin/* the API.
	handle {
		root * /srv
		try_files {path}.html {path}
		file_server
	}
}

# The connected domains, whose A record points here, only serve their NIP-05.
https:// {
	tls {
		on_demand
	}

	handle /.well-known/nostr.json {
		reverse_proxy server:3000
	}

	handle {
		respond 404
	}
}
