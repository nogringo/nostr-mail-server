# Host name of the site, the API and the inbound SMTP server (the MX of the
# connected domains). Its A record points at this machine, and so does
# nostr.<SITE_HOST>, the relay and Blossom server mail is sent through, with an
# A record or a CNAME to SITE_HOST. Required.
SITE_HOST=mail.example.com

# IPv4 address of this machine, which the connected domains point their A
# record at so that their NIP-05 is served here. Required.
PUBLIC_IPV4=203.0.113.10

# Password of the Postgres user, hex so it fits in a URL as is. Required.
# openssl rand -hex 32
POSTGRES_PASSWORD=

# Npubs or hex public keys, comma-separated, that can sign in at /admin and see
# every domain connected to the server. They also receive the mail sent to
# abuse@ on every domain. Default: nobody.
ADMIN_PUBKEYS=
